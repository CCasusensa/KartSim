# KartSim 客户端镜像的 Nginx（docker-compose.yml 的 client）：页面、游戏资源，
# 以及同源转发的联机接口。${KART_GAME_PORT} 由 nginx 镜像的模板机制替换。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream kart_data {
    server kart-data:8787;
    keepalive 16;
}
upstream kart_game {
    server kart-node:${KART_GAME_PORT};
}

server {
    listen 8780;
    # 局域网和公网的浏览器需要 HTTPS（游戏要求安全上下文）；本机 http://localhost 也可以。
    listen 8443 ssl;
    http2 on;
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;

    root /srv/web;
    client_max_body_size 8m;

    # 构建时已为 JS、CSS、wasm 生成 .gz；其余文本与数据服务的 JSON 现场压缩。游戏资源本身已压缩。
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json application/wasm;

    # 页面与 service worker 每次都向服务器确认，换版本后立即生效；/assets/ 下的文件名带内容哈希，长期缓存。
    location = / {
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 资源清单是没有扩展名的 JSON。
    location ~ ^/__p[0-9]+/resources$ {
        default_type application/json;
    }

    # 游戏节点（全局大厅把比赛交给它时，浏览器经同源连接它；WebRTC 的 UDP 直连节点）。
    location = /multiplayer/ws {
        proxy_pass http://kart_game;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
    location = /multiplayer/offer {
        proxy_pass http://kart_game;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 数据服务的 WebSocket：全局大厅、好友私聊、小屋拜访。
    location ~ ^/(multiplayer/lobby/ws|api/messenger/ws|api/myroom/ws)$ {
        proxy_pass http://kart_data;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 数据服务：账号、大厅票据、游戏服列表、管理后台，以及其他机器上的节点用密钥调用的 /multiplayer/internal/。
    # X-Forwarded-Host 让 auth/config 回答“同源”（backendOrigin: null）。
    location ~ ^/(multiplayer|api)/ {
        proxy_pass http://kart_data;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
